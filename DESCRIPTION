Package: rrGDM
Type: Package
Title: Reduced-Rank Generalised Dissimilarity Modelling
Version: 0.1.0
Authors@R: c(
    person(
      "Daniel", "Hernandez Carrasco",
      email = "dani.hc97@gmail.com",
      role = c("aut", "cre", "cph"),
      comment = c(ORCID = "0000-0002-1639-7511")
    )
